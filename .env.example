# Copiar para .env e preencher. NUNCA versionar o .env real.

# ---- Base de dados MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cardapio
DB_PASSWORD=
DB_NAME=cardapio_online

# ---- Servidor ----
PORT=8081
GIN_MODE=release
MAIN_DOMAIN=exemplo.pt

# ---- Autenticação (Fase 0) ----
# Gerar com: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=60
REFRESH_TTL_HOURS=720

# ---- Seeders de demonstração: manter false em produção ----
SEED_DEMO_DATA=false

# ---- Infra-estrutura ----
# Endereço TLS do Traefik na rede interna. Usado para confirmar, sem depender de DNS
# externo, se o endereço de um restaurante novo já responde e já tem certificado.
TRAEFIK_INTERNAL_ADDR=cardapio_traefik:443

# ---- Web Push Notifications ----
# Gerar com: docker run --rm node:20-alpine npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Painel da plataforma (/plataforma) ----
# Cria a PRIMEIRA conta de quem opera o SaaS, e só isso: depois de existir uma conta, estas
# variáveis são ignoradas, para que um reinício não reponha uma senha já mudada no painel.
# Se ficarem vazias, o painel existe mas não tem como ser aberto.
#
# A senha passa pela mesma validação de força das dos lojistas e o arranque FALHA se for
# fraca — esta conta vê todos os restaurantes. Depois de entrar, mude-a no painel e remova
# a linha daqui.
PLATAFORMA_ADMIN_EMAIL=
PLATAFORMA_ADMIN_PASSWORD=
