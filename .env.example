# Copiar para .env e preencher. NUNCA versionar o .env real.

# ---- Base de dados MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cardapio
DB_PASSWORD=
DB_NAME=cardapio_online

# ---- Servidor ----
PORT=8081
GIN_MODE=release
MAIN_DOMAIN=exemplo.pt

# ---- Autenticação (Fase 0) ----
# Gerar com: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=60
REFRESH_TTL_HOURS=720

# ---- Seeders de demonstração: manter false em produção ----
SEED_DEMO_DATA=false

# ---- Infra-estrutura ----
# Endereço TLS do Traefik na rede interna. Usado para confirmar, sem depender de DNS
# externo, se o endereço de um restaurante novo já responde e já tem certificado.
TRAEFIK_INTERNAL_ADDR=cardapio_traefik:443
